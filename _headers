# 静态资源使用以下基础 CSP；HTML 的完整策略及上报由 functions/_middleware.js 设置，
# 并为 Cloudflare JavaScript Detections 加上每个响应独立的 nonce。
# Web Analytics 来自 static.cloudflareinsights.com，自动注入模式向同源 /cdn-cgi/rum 上报。
# Rocket Loader 的同源脚本和官方兼容域 ajax.cloudflare.com 均允许加载。
# HTML 的图片、媒体、连接限制先上报；消息中允许用户引用外部媒体。
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  Content-Security-Policy: script-src 'self' https://static.cloudflareinsights.com https://ajax.cloudflare.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# 页面、代码与版本信息每次使用前重新验证，确保更新后切换到新后端。
# 缓存规则按资源类型设置，避免 Pages 合并相互冲突的 Cache-Control。
/
  Cache-Control: no-cache

/auth/*
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/*.js
  Cache-Control: no-cache

/*.css
  Cache-Control: no-cache

/*.json
  Cache-Control: no-cache

# 音效为内容固定的二进制资源，改名即换版本。
/se_cord.opus
  Cache-Control: public, max-age=31536000, immutable

/se_cord.mp3
  Cache-Control: public, max-age=31536000, immutable

/se_dcord.opus
  Cache-Control: public, max-age=31536000, immutable

/se_dcord.mp3
  Cache-Control: public, max-age=31536000, immutable
