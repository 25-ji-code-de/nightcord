{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nightcord-chat",
  "account_id": "5694444d23d3a8eea30dd74eb665633b",
  "main": "src/chat.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "DM_MODE": "on",
    "ROOMS_MODE": "on",
    "ROOMS_CREATE": "on",
    "ROOMS_DISCOVERY": "on",
    "ROOMS_OFFICIAL": [
      { "id": "nightcord-default", "name": "作业", "description": "Nightcord 官方公共聊天室。" },
      { "id": "nightcord-roleplay", "name": "语C", "description": "以角色身份发言的官方频道。" }
    ],
    "DM_MAX_BYTES": "52428800",
    "DM_REQUESTS_HOUR": "10",
    "DM_REQUESTS_DAY": "30",
    "VOICE_MODE": "on",
    "VOICE_ALLOWED_ROOMS": "nightcord-test,nightcord-default",
    "VOICE_REQUIRE_PASS": "true",
    "VOICE_MONTHLY_MINUTES": "230000",
    "VOICE_DAILY_MINUTES": "240",
    "CHAT_ALLOWED_ORIGINS": "https://nightcord.de5.net,http://localhost:8000,http://127.0.0.1:8000"
  },
  "d1_databases": [{ "binding": "ROOM_DIRECTORY", "database_name": "nightcord-rooms", "database_id": "2a8307f7-5298-47b1-b229-8a2b18921b03", "migrations_dir": "migrations" }],
  "services": [
    { "binding": "SEKAI_PASS", "service": "sekai-pass" }
  ],
  "routes": [
    { "pattern": "chat.nightcord.de5.net", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MANAGED_ROOMS", "class_name": "ManagedRoom" },
      { "name": "ROOMS", "class_name": "ChatRoom" },
      { "name": "DM_ROOMS", "class_name": "DirectRoom" },
      { "name": "DM_INBOXES", "class_name": "UserInbox" },
      { "name": "VOICE_ROOMS", "class_name": "VoiceRoom" },
      { "name": "VOICE_QUOTAS", "class_name": "VoiceQuota" },
      { "name": "LIMITERS", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRoom", "RateLimiter"] },
    { "tag": "v2-voice", "new_sqlite_classes": ["VoiceRoom"] },
    { "tag": "v3-voice-quota", "new_sqlite_classes": ["VoiceQuota"] },
    { "tag": "v4-direct-messages", "new_sqlite_classes": ["DirectRoom", "UserInbox"] },
    { "tag": "v5-managed-rooms", "new_sqlite_classes": ["ManagedRoom"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
