{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nightcord-chat",
  "account_id": "5694444d23d3a8eea30dd74eb665633b",
  "main": "src/chat.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "VOICE_MODE": "on",
    "VOICE_ALLOWED_ROOMS": "nightcord-test,nightcord-default",
    "VOICE_REQUIRE_PASS": "true",
    "VOICE_MONTHLY_MINUTES": "230000",
    "VOICE_DAILY_MINUTES": "240",
    "CHAT_ALLOWED_ORIGINS": "https://nightcord.de5.net,http://localhost:8000,http://127.0.0.1:8000"
  },
  "services": [
    { "binding": "SEKAI_PASS", "service": "sekai-pass" }
  ],
  "routes": [
    { "pattern": "chat.nightcord.de5.net", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ChatRoom" },
      { "name": "VOICE_ROOMS", "class_name": "VoiceRoom" },
      { "name": "VOICE_QUOTAS", "class_name": "VoiceQuota" },
      { "name": "LIMITERS", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRoom", "RateLimiter"] },
    { "tag": "v2-voice", "new_sqlite_classes": ["VoiceRoom"] },
    { "tag": "v3-voice-quota", "new_sqlite_classes": ["VoiceQuota"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
